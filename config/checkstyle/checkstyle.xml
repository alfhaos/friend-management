<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Baseline deliberately avoids a repository-wide formatting rewrite. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="NewlineAtEndOfFile"/>
    <module name="RegexpSingleline">
        <property name="format" value="^(?:&lt;{7}|={7}|&gt;{7})(?: |$)"/>
        <property name="message" value="Resolve merge conflict markers before committing."/>
    </module>
    <module name="TreeWalker">
        <module name="OuterTypeFilename"/>
        <module name="EmptyStatement"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun,com.sun"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\bSystem\s*\.\s*(out|err)\b|\.\s*printStackTrace\s*\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Use the application logger instead of console or stack trace output."/>
        </module>
    </module>
</module>
