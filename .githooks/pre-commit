#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/pre-commit.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pre-commit.ps1
else
    echo 'PowerShell is required for the repository quality gate.' >&2
    exit 1
fi
